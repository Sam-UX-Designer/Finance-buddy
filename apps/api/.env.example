# Copy to .env for local development. Never commit real secrets.
PORT=4000
NODE_ENV=development

# Production: Supabase pooler URL (transaction mode), e.g.
#   postgres://fb_api.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Leave empty locally to use the embedded Postgres (PGlite) in DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=./data/pglite
# Sandbox mode: allows the test OTP and sandbox AA in a deployed environment.
SANDBOX_MODE=false

# 32-byte base64 key for field-level encryption. Generate: openssl rand -base64 32
# In development a key is generated into ./data/.dev-key if this is empty.
DATA_ENCRYPTION_KEY=

# OTP: "dev" logs codes and accepts the fixed code below. Production needs a real SMS provider.
SMS_PROVIDER=dev
OTP_DEV_FIXED_CODE=123456

# Account Aggregator provider: "mock" (sandbox persona) until partner UAT credentials exist.
AA_PROVIDER=mock
# Simulated AA network latency for data fetch (ms).
MOCK_AA_LATENCY_MS=1500
# Comma-separated FIP ids that should fail during data fetch (to test partial-data states), e.g. sbi
MOCK_AA_FAIL_FIPS=
# Shared secret for verifying AA webhook signatures (HMAC-SHA256 of the raw body).
AA_WEBHOOK_SECRET=change-me

# Optional: enables Claude to phrase SI answers (still grounded in Finance Engine facts).
ANTHROPIC_API_KEY=
SI_MODEL=claude-opus-5-5

# Allowed web origins for CORS (comma-separated). Empty = allow all in development.
CORS_ORIGINS=
